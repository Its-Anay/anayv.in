---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Blog — Anay Vyawahare">
  <section class="section" style="max-width:700px">
    <h2 class="section-title"><span class="section-num">05.</span> Blog</h2>
    {posts.length === 0
      ? <p class="empty-state">No posts yet — check back soon.</p>
      : posts.map(post => (
          <div class="project-card" style="margin-bottom:20px">
            <p class="blog-meta">{post.data.date.toISOString().slice(0, 10)}</p>
            <a href={`/blogs/${post.slug}`}><h3 class="project-name">{post.data.title}</h3></a>
            <p class="project-desc">{post.data.summary}</p>
            <ul class="project-tech">
              {post.data.tags.map(tag => <li>{tag}</li>)}
            </ul>
          </div>
        ))
    }
  </section>
</Base>
